{
  "name": "silly-goose-mutual",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "services:up": "docker compose up -d --wait",
    "services:down": "docker compose down",
    "db:migrate": "pnpm --filter web db:migrate",
    "db:seed": "pnpm --filter web db:seed",
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "lint": "pnpm --filter web lint",
    "typecheck": "pnpm --filter web typecheck",
    "corpus:build": "cd generator && python3 -m sgm.build",
    "corpus:load": "pnpm --filter web corpus:load",
    "setup:python": "python3 -m pip install -r generator/requirements.txt",
    "site:build": "bash scripts/site/build.sh",
    "index:build": "pnpm --filter web index:build",
    "eval:retrieval": "pnpm --filter web eval:retrieval"
  }
}
