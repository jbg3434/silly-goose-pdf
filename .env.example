# Local development defaults (docker compose). Copy to apps/web/.env.local or export.
DATABASE_URL=postgres://goose:goose@localhost:5433/silly_goose
# Local filesystem stand-in for object storage (artifacts, manifests).
ARTIFACT_ROOT=../../storage
# Provider adapters (stage 4+). Leave blank to run with AI disabled.
LLM_PROVIDER=
LLM_API_KEY=
EMBEDDING_PROVIDER=
EMBEDDING_API_KEY=
